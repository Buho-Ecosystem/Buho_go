# Build-time environment for BuhoGO.
# Copy to .env.local (untracked) and fill in real values. Never commit keys.

# Breez SDK API key. Mandatory for Spark wallets: the Breez engine is the
# only Spark engine, and it refuses to build without a key. A build shipped
# without one cannot connect any Spark wallet.
VITE_BREEZ_API_KEY=

# Bitrefill shop (docs/BITREFILL.md). Off unless VITE_BITREFILL_ENABLED=true:
# Bitrefill approves each integration, so a build shipped before that keeps
# the shop closed (Spend says it is on its way; /bitrefill leads to Spend).
# Then the name Bitrefill approved the widget integration under, and BuhoGO's
# referral code. Until approval a local build can use Bitrefill's demo source:
# VITE_BITREFILL_ENABLED=true VITE_BITREFILL_UTM_SOURCE=bitrefill_demo
VITE_BITREFILL_ENABLED=
VITE_BITREFILL_UTM_SOURCE=buhogo
VITE_BITREFILL_REF=
