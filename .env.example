# Build-time environment for BuhoGO.
# Copy to .env.local (untracked) and fill in real values. Never commit keys.

# Breez SDK API key. Mandatory for Spark wallets: the Breez engine is the
# only Spark engine, and it refuses to build without a key. A build shipped
# without one cannot connect any Spark wallet.
VITE_BREEZ_API_KEY=
