<?xml version="1.0" encoding="utf-8"?>
<!-- The app icon: the BuhoGO mark inside the launcher's safe zone, and the
     same mark as the monochrome layer for themed icons (drawable/ic_launcher_mark.xml). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_mark"/>
    <monochrome android:drawable="@drawable/ic_launcher_mark"/>
</adaptive-icon>
