<?xml version="1.0" encoding="utf-8"?>
<!-- Before Android 8 (no adaptive icons): the glyph on a disc. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/quick_access_icon_background" />
            <size android:width="48dp" android:height="48dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_shortcut_receive_glyph"
        android:bottom="12dp"
        android:left="12dp"
        android:right="12dp"
        android:top="12dp" />
</layer-list>
