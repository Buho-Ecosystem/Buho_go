<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher masks it to its own shape; the glyph sits well inside the safe zone. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/quick_access_placeholder_background" />
    <foreground>
        <inset android:drawable="@drawable/ic_shortcut_person_glyph" android:inset="33%" />
    </foreground>
    <monochrome>
        <inset android:drawable="@drawable/ic_shortcut_person_glyph" android:inset="33%" />
    </monochrome>
</adaptive-icon>
